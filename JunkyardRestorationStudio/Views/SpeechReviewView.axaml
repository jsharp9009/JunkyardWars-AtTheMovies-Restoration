<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JunkyardRestorationStudio.ViewModels"
             x:Class="JunkyardRestorationStudio.Views.SpeechReviewView"
             x:DataType="vm:SpeechReviewViewModel"
             KeyDown="UserControl_KeyDown">

    <Grid Margin="15" RowDefinitions="Auto,*" ColumnDefinitions="310,*">
        <Grid Grid.Row="0" RowDefinitions="Auto,*" Grid.ColumnSpan="2" Margin="0,0,0,12">
            <Grid Row="0" ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Status}" VerticalAlignment="Bottom"/>
                <StackPanel Grid.Column="1">
                    <TextBlock HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Text="{Binding Project.CurrentPosition}"/>
                    <ProgressBar Margin="0,6,0,4" Height="18" Minimum="0" Maximum="1" Value="{Binding Project.Progress}"/>
                    <TextBlock HorizontalAlignment="Right" Text="{Binding Project.ProgressText}"/>
                </StackPanel>
            </Grid>
            <Border Classes="Card" Grid.Row="1" Margin="0,10,0,0">
                <StackPanel Spacing="6" Orientation="Horizontal">
                    <TextBlock Classes="Section" Text="Files"/>
                    <TextBlock Text="Evidence map:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <TextBox Text="{Binding MapPath}" VerticalAlignment="Center" MaxWidth="180"/>
                    <TextBlock Text="Decisions:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <TextBox Text="{Binding DecisionsPath}" VerticalAlignment="Center" MaxWidth="180"/>
                    <TextBlock Text="Audio:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <TextBox Text="{Binding AudioPath}" VerticalAlignment="Center" MaxWidth="180"/>
                    <Button Classes="Action" Content="Reload Evidence" Command="{Binding LoadCommand}"/>
                    <Button Classes="Action" Content="Save All" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="10" Margin="0,0,12,0">
            <Border Classes="Card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="Section" Text="Playback"/>
                    <Grid ColumnDefinitions="auto,auto,auto" ColumnSpacing="6">
                        <Button Classes="Action" Content="Play Region" Command="{Binding PlayCommand}"/>
                        <Button Grid.Column="1" Classes="Action" Content="Play + Context" Command="{Binding PlayContextCommand}"/>
                        <Button Grid.Column="2" Classes="Action" Content="Stop" Command="{Binding StopCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="Card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="Section" Text="Navigation"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Button Classes="Action" Content="Save &amp; Previous" Command="{Binding PreviousCommand}"/>
                        <Button Grid.Column="1" Classes="Action" Content="Save &amp; Next" Command="{Binding NextCommand}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Text="{Binding JumpId}" Watermark="Region ID"/>
                        <Button Grid.Column="1" Classes="Action" Content="Go" Command="{Binding JumpCommand}"/>
                    </Grid>
                    <TextBlock Text="1 = play region    2 = play with context"/>
                    <TextBlock Text="← / → = save + previous / next    Space = play" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Classes="Card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="Section" Text="Boundary Adjustment"/>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                        <Button Classes="Action" Content="Start −0.10s" Command="{Binding NudgeStartEarlierCommand}"/>
                        <Button Grid.Column="1" Classes="Action" Content="Start +0.10s" Command="{Binding NudgeStartLaterCommand}"/>
                        <Button Grid.Row="1" Classes="Action" Content="End −0.10s" Command="{Binding NudgeEndEarlierCommand}"/>
                        <Button Grid.Row="1" Grid.Column="1" Classes="Action" Content="End +0.10s" Command="{Binding NudgeEndLaterCommand}"/>
                    </Grid>
                    <TextBlock Text="Boundary changes are saved immediately." TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Classes="Card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="Section" Text="Review Status"/>
                    <TextBlock Text="{Binding Project.CurrentRegion.EvidenceFlagsDisplay}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Project.CurrentRegion.PositionDisplay}"/>
                    <TextBlock Text="{Binding Project.CurrentRegion.BoundaryDisplay}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <Border Classes="Card">
                    <Grid ColumnDefinitions="80,*,120,220">
                        <TextBlock FontWeight="Bold" Text="Region"/>
                        <TextBlock Grid.Column="1" FontWeight="Bold" Text="{Binding Project.CurrentRegion.PositionDisplay}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Project.CurrentRegion.DurationDisplay}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Project.CurrentRegion.BoundaryDisplay}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Border Classes="Card">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="Section" Text="Russian Source Evidence"/>
                        <TextBlock FontSize="20" TextWrapping="Wrap" Text="{Binding Project.CurrentRegion.RussianText}"/>
                    </StackPanel>
                </Border>

                <Border Classes="Card">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="Section" Text="Translation Candidates"/>
                        <TextBlock TextWrapping="Wrap" FontFamily="Consolas" Text="{Binding Project.CurrentRegion.TranslationCandidatesDisplay}"/>
                    </StackPanel>
                </Border>

                <Border Classes="Card">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="Section" Text="Recovered English Audio ASR"/>
                        <TextBlock FontSize="20" TextWrapping="Wrap" Text="{Binding Project.CurrentRegion.RecoveredEnglishText}"/>
                        <TextBlock Text="{Binding Project.CurrentRegion.TranslatedRegionText}" TextWrapping="Wrap" Opacity="0.65"/>
                    </StackPanel>
                </Border>

                <Border Classes="Card">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="Section" Text="Final Wording"/>
                        <TextBox AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="90"
                                 Text="{Binding Project.CurrentRegion.FinalText, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="Enter the wording supported by the evidence"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackPanel>
                                <TextBlock Text="Confidence"/>
                                <ComboBox ItemsSource="{Binding ReviewConfidenceOptions}"
                                          SelectedItem="{Binding Project.CurrentRegion.ReviewConfidence}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Evidence source"/>
                                <ComboBox ItemsSource="{Binding EvidenceSourceOptions}"
                                          SelectedItem="{Binding Project.CurrentRegion.EvidenceSource}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="Card">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="Section" Text="Speaker / Audio Review"/>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <StackPanel>
                                <TextBlock Text="English quality"/>
                                <ComboBox ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding Project.CurrentRegion.Quality}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Speaker"/>
                                <ComboBox ItemsSource="{Binding SpeakerOptions}" SelectedItem="{Binding Project.CurrentRegion.Speaker}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Speaker confidence"/>
                                <ComboBox ItemsSource="{Binding SpeakerConfidenceOptions}" SelectedItem="{Binding Project.CurrentRegion.SpeakerConfidence}"/>
                            </StackPanel>
                        </Grid>
                        <Grid IsVisible="{Binding Project.CurrentRegion.IsKnownSpeaker}" ColumnDefinitions="140,*">
                            <TextBlock Text="Speaker name:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Project.CurrentRegion.KnownSpeakerName}" Watermark="Enter speaker name"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="Card">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="Section" Text="Notes"/>
                        <TextBox AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="80"
                                 MaxHeight="140"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Project.CurrentRegion.Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="What did you hear, what conflicts, and what should be checked?"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
