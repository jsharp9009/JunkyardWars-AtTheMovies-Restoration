<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JunkyardRestorationStudio.ViewModels"
             x:Class="JunkyardRestorationStudio.Views.SpeechReviewView"
             x:DataType="vm:SpeechReviewViewModel"
             KeyDown="UserControl_KeyDown">

    <Grid Margin="15" RowDefinitions="Auto,*" ColumnDefinitions="310,*">
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12" ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Classes="Header" Text="Speech Restoration Review"/>
                <TextBlock Text="Review natural speech regions before AI-assisted restoration."/>
                <TextBlock Text="{Binding Status}"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="Action" Content="Save All" Command="{Binding SaveCommand}" MinWidth="100"/>
        </Grid>

        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="10" Margin="0,0,12,0">
            <Border Classes="Card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="Section" Text="Files"/>
                    <TextBlock Text="Speech map"/>
                    <TextBox Text="{Binding MapPath}"/>
                    <TextBlock Text="Decisions"/>
                    <TextBox Text="{Binding DecisionsPath}"/>
                    <TextBlock Text="Audio"/>
                    <TextBox Text="{Binding AudioPath}"/>
                    <Button Classes="Action" Content="Reload Map" Command="{Binding LoadCommand}" MinHeight="38" FontSize="15"/>
                </StackPanel>
            </Border>

            <Border Classes="Card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="Section" Text="Navigation"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Button Classes="Action" Content="Save &amp; Previous" Command="{Binding PreviousCommand}"/>
                        <Button Grid.Column="1" Classes="Action" Content="Save &amp; Next" Command="{Binding NextCommand}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Text="{Binding JumpId}" Watermark="Region ID"/>
                        <Button Grid.Column="1" Classes="Action" Content="Go" Command="{Binding JumpCommand}"/>
                    </Grid>
                    <TextBlock Text="1 = play region    2 = play with context"/>
                    <TextBlock Text="← / → = save + previous / next    Space = play" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Classes="Card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="Section" Text="Boundary Adjustment"/>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                        <Button Classes="Action" Content="Start −0.10s" Command="{Binding NudgeStartEarlierCommand}"/>
                        <Button Grid.Column="1" Classes="Action" Content="Start +0.10s" Command="{Binding NudgeStartLaterCommand}"/>
                        <Button Grid.Row="1" Classes="Action" Content="End −0.10s" Command="{Binding NudgeEndEarlierCommand}"/>
                        <Button Grid.Row="1" Grid.Column="1" Classes="Action" Content="End +0.10s" Command="{Binding NudgeEndLaterCommand}"/>
                    </Grid>
                    <TextBlock Text="Boundary changes are saved immediately." TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
            <Border Classes="Card">
                <Grid ColumnDefinitions="80,*,120,220">
                    <TextBlock FontWeight="Bold" Text="Region"/>
                    <TextBlock Grid.Column="1" FontWeight="Bold" Text="{Binding CurrentRegion.PositionDisplay}"/>
                    <TextBlock Grid.Column="2" Text="{Binding CurrentRegion.DurationDisplay}"/>
                    <TextBlock Grid.Column="3" Text="{Binding CurrentRegion.BoundaryDisplay}" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Classes="Card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="Section" Text="Translated Dialogue"/>
                    <TextBlock FontSize="20" TextWrapping="Wrap" Text="{Binding CurrentRegion.Text}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Subtitle IDs:"/>
                        <TextBlock Text="{Binding CurrentRegion.SubtitleIdsDisplay}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Classes="Card">
                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="6">
                    <TextBlock VerticalAlignment="Center" Text="Start:"/>
                    <TextBox Grid.Column="1" Text="{Binding CurrentRegion.Start}" Margin="6,0,15,0"/>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="End:"/>
                    <TextBox Grid.Column="3" Text="{Binding CurrentRegion.End}" Margin="6,0,0,0"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Margin="0,8,0,0" Text="{Binding CurrentRegion.BoundaryDisplay}"/>
                </Grid>
            </Border>

            <Border Grid.Row="3" Classes="Card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="Section" Text="Playback"/>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                        <Button Classes="Action" Content="Play Region" Command="{Binding PlayCommand}"/>
                        <Button Grid.Column="1" Classes="Action" Content="Play + Context" Command="{Binding PlayContextCommand}"/>
                        <Button Grid.Column="2" Classes="Action" Content="Stop" Command="{Binding StopCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Classes="Card">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" ColumnDefinitions="140,*" RowSpacing="8">
                    <TextBlock Classes="Section" Grid.ColumnSpan="2" Text="Review"/>

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="English quality"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding CurrentRegion.Quality}"/>

                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Speaker"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SpeakerOptions}" SelectedItem="{Binding CurrentRegion.Speaker}"/>

                    <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Speaker confidence"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding SpeakerConfidenceOptions}" SelectedItem="{Binding CurrentRegion.SpeakerConfidence}"/>

                    <Grid Grid.Row="4" Grid.ColumnSpan="2" RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <Grid IsVisible="{Binding CurrentRegion.IsKnownSpeaker}" ColumnDefinitions="140,*">
                            <TextBlock VerticalAlignment="Center" Text="Speaker name"/>
                            <TextBox Grid.Column="1" Text="{Binding CurrentRegion.KnownSpeakerName}" Watermark="Enter speaker name"/>
                        </Grid>
                        <TextBox Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Stretch" MaxHeight="130" ScrollViewer.VerticalScrollBarVisibility="Auto" Watermark="Notes" Text="{Binding CurrentRegion.Notes}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
