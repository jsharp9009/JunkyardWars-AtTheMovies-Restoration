<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:JunkyardRestorationStudio.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="JunkyardRestorationStudio.Views.RunReviewView"
             x:DataType="vm:RunReviewViewModel"
             KeyDown="UserControl_KeyDown">
  

    <StackPanel>

                   <Grid ColumnDefinitions="*,Auto">
                       <TextBlock Grid.Column="0" Text="{Binding Status}" VerticalAlignment="Bottom"/> 
                    <StackPanel Grid.Column="1">
                <TextBlock HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Text="{Binding Project.CurrentPosition}" />
                <ProgressBar Margin="0,6,0,4" Height="18" Minimum="0" Maximum="1" Value="{Binding Project.Progress}" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding Project.ProgressText}" />
            </StackPanel>
                   </Grid>
                   
                
                <Grid Margin="0,12,0,0" ColumnDefinitions="320,*">
                    
                    <StackPanel Grid.Column="0" Margin="0,0,15,0" Spacing="15">
                        <Border Classes="Card">
                            <StackPanel>
                                <TextBlock Classes="Section" Text="Playback"/>
                                <WrapPanel>
                                    <Button Classes="Action" Content="20s" Command="{Binding Play20Command}" />
                                    <Button Classes="Action" Content="30s" Command="{Binding Play30Command}" />
                                    <Button Classes="Action" Content="45s" Command="{Binding Play45Command}" />
                                    <Button Classes="Action" Content="60s" Command="{Binding Play60Command}" />
                                    <Button Classes="Action" Content="Stop" Command="{Binding StopCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="Card">
                            <StackPanel>
                                <TextBlock Classes="Section" Text="Agreement"/>
                                <ItemsControl ItemsSource="{Binding Project.CurrentSegment.Analyses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="60,70,*" Margin="0,2">
                                                <TextBlock Text="{Binding RunName}"/>
                                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding ScoreDisplay}"/>
                                                <TextBlock Grid.Column="2" Margin="12,0,0,0" FontWeight="Bold" Foreground="{Binding AgreementBrush}" Text="{Binding AgreementText}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="Card">
                            <StackPanel>
                                <TextBlock Classes="Section" Text="Best Version"/>
                                <ComboBox Width="150" ItemsSource="{Binding Project.CurrentSegment.RunChoices}" SelectedItem="{Binding Project.CurrentSegment.Choice.SelectedRun}" />
                            </StackPanel>
                        </Border>

                        

                        <Border Classes="Card">
                            <StackPanel>
                                <TextBlock Classes="Section" Text="Keyboard"/>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Text="1-4"/>
                                    <TextBlock Grid.Column="1" Text="Play Clips"/>
                                    <TextBlock Grid.Row="1" Text="Q-R"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Select Run"/>
                                    <TextBlock Grid.Row="2" Text="Ctrl←"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Previous"/>
                                    <TextBlock Grid.Row="3" Text="Ctrl→"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Next"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Column="1" RowDefinitions="Auto,auto,*">
                        <Border Grid.Row="0" Classes="Card">
                            <StackPanel>
                                <TextBlock Classes="Section" Text="Segment Information"/>
                                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Text="Id:"/>
                                    <TextBlock Grid.Column="1" FontWeight="Bold" Text="{Binding Project.CurrentSegment.Id}" />
                                    <TextBlock Grid.Row="1" Text="Priority:"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="Bold" Foreground="{Binding Project.CurrentSegment.PriorityBrush}" Text="{Binding Project.CurrentSegment.Priority}" />
                                    <TextBlock Grid.Row="2" Text="Start:"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Project.CurrentSegment.TimeDisplay}" />
                                    <TextBlock Grid.Row="3" Text="Duration:"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Project.CurrentSegment.DurationDisplay}" />
                                    <TextBlock Grid.Row="4" Text="Spread:"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Project.CurrentSegment.SpreadDisplay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Classes="Card" Grid.Row="1">
                            <StackPanel>
                                <TextBlock Classes="Section" Text="Navigation"/>
                                <Grid ColumnDefinitions="Auto,Auto,Auto, *, Auto">
                                    <Button Grid.Column="0" Margin="5, 0" Classes="Action" Content="◀ Previous" Command="{Binding PreviousCommand}" />
                                    <Button Grid.Column="1" Margin="5, 0" Classes="Action" Content="Next ▶" Command="{Binding NextCommand}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10, 0, 5, 0" Text="Jump to Segment:"/>
                                    <TextBox Grid.Column="3" Text="{Binding JumpSegment}" Margin="0, 0, 10, 0" />
                                    <Button Grid.Column="4" Classes="Action" Content="Go" Command="{Binding JumpCommand}" />
                                </Grid>
                                    
                                </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Classes="Card">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Classes="Section" Text="Notes"/>
                                <TextBox Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="{Binding Project.CurrentSegment.Choice.Notes}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                    </StackPanel>

</ContentPage>
